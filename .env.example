# ─── Server ───
NGINX_PORT=80
DEBUG=false

# ─── Database ───
DB_USER=postgres
DB_PASSWORD=change_me_in_production
DB_NAME=enterprise
DB_PORT=5432

# ─── Redis ───
REDIS_PORT=6379

# ─── JWT ───
JWT_SECRET=                     # REQUIRED: at least 32 random chars (openssl rand -base64 48)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ─── Admin Bootstrap ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                 # REQUIRED: set strong password (min 10 chars)
ADMIN_EMAIL=admin@company.com

# ─── Indonesia Shipping (all required; no defaults) ───
INDO_SQL_SA_PASSWORD_B64=
INDO_SQL_APP_PASSWORD_B64=
INDO_SHIPPING_JWT_KEY_B64=
INDO_SHIPPING_ADMIN_PASSWORD_B64=

# ─── Stitch Cost Comparison (all required; no defaults) ───
STITCH_COST_JWT_SECRET=
STITCH_COST_ADMIN_PASSWORD=
# 总部集成同步（可选，默认关闭）：启用后从总部加工厂系统只读 API 定时增量拉取加工厂和订单
STITCH_COST_HQ_SYNC_ENABLED=false    # 置 true 启用定时同步（手动触发接口 /api/hq-sync/run 不受此开关限制）
STITCH_COST_HQ_BASE_URL=             # 总部 API 根地址，如 https://hq.example.com
STITCH_COST_HQ_API_KEY=              # 总部发放的 Bearer 密钥（至少 24 位）

# ─── QC Finished Goods Report (required before enabling qc-report) ───
QC_REPORT_SECRET_KEY=
QC_REPORT_ADMIN_PASSWORD=
QC_REPORT_QC_PASSWORD=
QC_REPORT_OPENAI_API_KEY=
QC_REPORT_OPENAI_MODEL=gpt-5.6-terra
QC_REPORT_COOKIE_SECURE=false

# ─── Factory Review 对车缝核价对比系统的只读集成 API ───
# 只读对接密钥：至少 32 字节的随机串（例如 openssl rand -hex 32），测试与生产分开；
# 留空时集成接口一律返回 401，不影响系统其它功能。
FACTORY_REVIEW_INTEGRATION_API_KEY=
