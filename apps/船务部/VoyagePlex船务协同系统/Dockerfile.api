FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY server/VoyagePlex.Api/VoyagePlex.Api.csproj server/VoyagePlex.Api/
RUN dotnet restore server/VoyagePlex.Api/VoyagePlex.Api.csproj
COPY server/VoyagePlex.Api server/VoyagePlex.Api
COPY seed seed
RUN dotnet publish server/VoyagePlex.Api/VoyagePlex.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
EXPOSE 5088
ENTRYPOINT ["dotnet", "VoyagePlex.Api.dll"]
