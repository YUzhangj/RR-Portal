FROM node:22-alpine AS build
WORKDIR /app
# China 网络：registry.npmjs.org 直连超时（部署 ECS 在阿里云内，npm ci 19min 后 ETIMEDOUT）。
# 构建期改用 npmmirror，与 sprayplan Dockerfile 同一模式；仅作用于构建阶段。
ENV npm_config_registry=https://registry.npmmirror.com \
    NEXT_TELEMETRY_DISABLED=1
COPY package*.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_BASE_PATH=/voyageplex
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_PUBLIC_BASE_PATH=/voyageplex NEXT_DIST_DIR=.next-build
COPY --from=build /app/package*.json ./
# next start 需要 next.config.mjs 才能读到 distDir=.next-build，
# 缺了它运行时回退默认 .next → "Could not find a production build in the '.next' directory" 崩溃循环
COPY --from=build /app/next.config.mjs ./next.config.mjs
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next-build ./.next-build
COPY --from=build /app/seed ./seed
COPY docker-entrypoint-web.sh /usr/local/bin/voyageplex-web
RUN chmod +x /usr/local/bin/voyageplex-web
EXPOSE 3000
ENTRYPOINT ["voyageplex-web"]
