# Copy this file to .env. Never commit the populated .env file.
SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_DB=qc_reports
POSTGRES_USER=qc_app
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-database-password
ADMIN_PASSWORD=replace-with-a-strong-admin-password
QC_PASSWORD=replace-with-a-strong-qc-password
COOKIE_SECURE=false
PORT=3410
PROXY_PREFIX=/qc-report
SESSION_COOKIE_PATH=/qc-report/

# OpenAI credentials are injected at runtime only. Leave the key empty to keep
# non-AI screens available while AI actions report "not configured".
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=12000
AI_MAX_DOCUMENT_BYTES=26214400
AI_MAX_IMAGE_BYTES=20971520
AI_MAX_TOTAL_IMAGE_BYTES=47185920
AI_MAX_PHOTOS=80

# Deterministic fixtures are for local/test use only. Keep false in production.
AI_MOCK_MODE=false
AI_MOCK_FIXTURE=long_loose_thread

# Docker Compose sets REDIS_URL internally. For local SQLite development, leave
# REDIS_URL unset so importing/running the web app does not require Redis.
# REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=qc-ai
RQ_JOB_TIMEOUT_SECONDS=900
RQ_RESULT_TTL_SECONDS=604800
RQ_FAILURE_TTL_SECONDS=1209600
REDIS_CONNECT_TIMEOUT_SECONDS=3
