   }
   const row = db.prepare('SELECT * FROM pi_warehouse_orders WHERE id = ?').get(req.params.id);
   res.json(row);
+  // ERP webhook：入库成功后主动推送整行给 ERP（fire-and-forget，失败只记日志不影响入库）
+  // 配置：ERP_WEBHOOK_URL（如 http://erp主机:5000/api/integrations/paiji/warehouse-checkin）+ ERP_WEBHOOK_TOKEN
+  if (!undo && row && process.env.ERP_WEBHOOK_URL) {
+    fetch(process.env.ERP_WEBHOOK_URL, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        ...(process.env.ERP_WEBHOOK_TOKEN ? { 'X-Webhook-Token': process.env.ERP_WEBHOOK_TOKEN } : {}),
+      },
+      body: JSON.stringify(row),
+    }).catch(err => console.error('[erp-webhook] 推送失败:', err.message));
+  }
 });
 
