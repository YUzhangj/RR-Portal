FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN PUPPETEER_SKIP_DOWNLOAD=true npm ci --production

COPY server.js monthly.js ./
COPY scripts/ ./scripts/
COPY public/ ./public/
COPY data/ ./data/

# 确保 data 目录可写
RUN chmod -R 777 /app/data

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --retries=3   CMD wget -qO- http://127.0.0.1:3000/health || exit 1

CMD ["node", "server.js"]
