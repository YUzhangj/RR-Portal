# 复制为 .env 并填入真实值，不提交到仓库
#
# OCR 后端: 阿里云百炼 (Bailian) OpenAI 兼容端点 + 通义千问 VL

# 必填: 阿里云百炼 API key
# (https://bailian.console.aliyun.com/?tab=model#/api-key)
BAILIAN_API_KEY=

# 可选: 百炼 OpenAI 兼容端点，默认北京区域
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选: 通义千问多模态模型，默认 qwen3-vl-plus
# 模型、API key、端点地域和业务空间权限需一致
BAILIAN_MODEL=qwen3-vl-plus

# 登录(单密码模式)
# AUTH_USERNAME / AUTH_PASSWORD 必填,否则启动报错
AUTH_USERNAME=
AUTH_PASSWORD=
# 可选: 不设会自动在 instance/.secret_key 生成并持久化
# 要手动设也行: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
